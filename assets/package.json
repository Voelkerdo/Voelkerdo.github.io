{
  "name": "portfolio-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run e2e",
    "security": "npm audit --audit-level=low && npm audit signatures"
  },
  "dependencies": {
    "@sap-theming/theming-base-content": "11.36.4",
    "@ui5/webcomponents": "^2.28.1",
    "@ui5/webcomponents-base": "^2.28.1",
    "@ui5/webcomponents-fiori": "^2.28.1",
    "@ui5/webcomponents-icons": "^2.28.1",
    "@ui5/webcomponents-react": "^2.28.2",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
